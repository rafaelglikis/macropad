[Unit]
Description=Macropad Keyboard Interceptor
After=default.target

[Service]
Type=simple
WorkingDirectory=@WORKING_DIRECTORY@
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
ExecStart=@EXECUTABLE@ listen --watch
KillMode=mixed
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
